{
  "name": "songbook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "cmd /c npx prisma generate --schema=server/prisma/schema.prisma",
    "db:push": "cmd /c npx prisma db push --schema=server/prisma/schema.prisma",
    "db:studio": "cmd /c npx prisma studio --schema=server/prisma/schema.prisma",
    "db:seed": "node server/prisma/migrate-v2.js"
  },
  "dependencies": {
    "@coderline/alphatab": "^1.8.4",
    "@heroicons/react": "^2.2.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1",
    "tone": "^14.9.17",
    "tonejs-instrument-guitar-acoustic-ogg": "^1.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0",
    "vitest": "^4.1.11"
  }
}
